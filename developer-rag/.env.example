# Copy to .env (git-ignored; read only from developer-rag/.env; a variable already set in the environment wins over .env) and fill in what you need.
# EVERY line here is optional except the key for live answers. Placeholders only: never put a real key in this file, it is committed.
# A blank value is ignored (the default applies). Numeric, URL and collection-name values are validated at start-up and a bad one stops the command
# with a message that names the variable. Boolean flags are lenient (anything but 1/true/yes/on is off); models and paths are not checked until used.
# Not every setting has a variable: page/chunk/per-owner upload limits, max_prompt_chars and similar are fixed in sdk_engine/config.py.

# ---- the model provider (an OpenAI-compatible endpoint; Groq by default) -------------------------------------------------
# Needed only for generated answers. Without it the engine still retrieves and returns cited excerpts (--no-llm behaviour). `index rebuild` needs no key.
# GROQ_API_KEY is the provider's name for it; the older GROK_API_KEY spelling used by the Week 1-11 scripts is also read.
GROQ_API_KEY=
#SDK_ENGINE_MODEL=openai/gpt-oss-120b
#SDK_ENGINE_LLM_BASE_URL=https://api.groq.com/openai/v1      # https only (the key is sent here); plain http only for localhost
#SDK_ENGINE_LLM_MAX_TOKENS=1500                              # 16-4096; the gpt-oss models spend part of this on hidden reasoning
#SDK_ENGINE_LLM_TIMEOUT_S=45                                 # >0, <=300

# ---- retrieval ----------------------------------------------------------------------------------------------------------
#SDK_ENGINE_TOP_K=5                                          # 1-20 in the engine, but the MCP search tool serves at most 10: larger values are clamped to 10 on that path
#SDK_ENGINE_MAX_DISTANCE=0.65                                # sufficiency gate on cosine distance: a placeholder that never fires on this corpus (docs/week12/known_weaknesses.md #2)
#SDK_ENGINE_UPLOAD_MAX_DISTANCE=0.50                         # the same gate for your own uploads (measured on a small authored sample)
#SDK_ENGINE_HYBRID=0                                         # 1 = dense + keyword fusion (measured no better on this corpus)
#SDK_ENGINE_USE_RERANKER=0                                   # 1 = cross-encoder re-rank (~1.1 s p50 on CPU, no top-1 gain); applies ONLY to the in-process retriever (--no-mcp and the fallback), not to the MCP server
#SDK_ENGINE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5           # keep the default for `index rebuild` (the ingest script embeds with it); `hash-test` = deterministic fake embedding, tests only

# ---- where things live (defaults are under developer-rag/, never the current directory; a relative path YOU set resolves against the current directory) --
#SDK_ENGINE_CHROMA_PATH=
#SDK_ENGINE_COLLECTION=race_docs                             # letters, digits, _ and - only
#SDK_ENGINE_PAGE_METADATA=
#SDK_ENGINE_UPLOADS_PATH=                                    # private uploads: a separate store from the official index
#SDK_ENGINE_TRACE_DIR=

# ---- the version the caller did not give -------------------------------------------------------------------------------
# Used ONLY when the question names a product but no version. There is no built-in default: without one, the engine asks.
# A misspelled product suffix, or a version that product does not document, is ignored silently and the engine asks instead.
#SDK_ENGINE_DEFAULT_VERSION_GITHUB_REST=2022-11-28
#SDK_ENGINE_DEFAULT_VERSION_SWAGGER_CODEGEN=3.x

# ---- MCP tool server -----------------------------------------------------------------------------------------------------
#SDK_ENGINE_TOOL_TIMEOUT_S=20                                # per tool call; the engine then falls back to the in-process retriever
#SDK_ENGINE_MAX_TOOL_OUTPUT_CHARS=20000

# ---- answers and uploads -------------------------------------------------------------------------------------------------
#SDK_ENGINE_ANSWER_HOSTS=                                    # extra hosts an answer may link to, comma separated (added to the built-in list)
#SDK_ENGINE_MAX_UPLOAD_BYTES=5000000                         # 1000-50000000: the only upload limit with a variable
